# Copy this file to .env and edit it.
# For production set DEBUG=0 and a long random SECRET_KEY.
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when the site runs on HTTPS with a real domain, e.g. https://dminternetcafe.co.zw
CSRF_TRUSTED_ORIGINS=

CAFE_NAME=DM Internet Cafe
CURRENCY_SYMBOL=$

# Leave empty for SQLite. For PostgreSQL: postgres://user:password@localhost:5432/dmcafe
DATABASE_URL=

# "mock" = no router needed (for development/demo). "mikrotik" = real router.
ROUTER_MODE=mock
ROUTER_HOST=10.99.0.2
ROUTER_PORT=8728
ROUTER_USER=portal
ROUTER_PASSWORD=
# Hosts the portal is allowed to send customers back to after a valid code (the router's hotspot address)
HOTSPOT_LOGIN_HOSTS=10.5.50.1,192.168.88.1
